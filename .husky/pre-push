# Checks only a branch's first push: it comes before the PR, and later pushes mostly answer reviews of it.
while read -r local_ref _local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  # Anything but all zeros means the remote already has the branch, which also covers deleting it.
  case "$remote_sha" in *[!0]*) continue ;; esac

  case "$local_ref" in
    refs/heads/*) branch=${local_ref#refs/heads/} ;;
    HEAD) branch=$(git symbolic-ref --quiet --short HEAD || true) ;;
    *) branch= ;;
  esac
  if ! git config --get "branch.$branch.prePrReviewed" >/dev/null 2>&1; then
    echo "BLOCKED: no /pre-pr review recorded for ${branch:-a commit not on a checked-out branch}. Run /pre-pr on it first, or push with --no-verify if it needs none." >&2
    exit 1
  fi
done
