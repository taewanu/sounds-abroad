{
  "name": "sounds-abroad",
  "version": "2.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest --watch=false --reporter=default --reporter=github-actions",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test --run && pnpm build",
    "health": "curl -fsS https://soundsabroad.app/api/health",
    "ship": "tsx scripts/ship/main.ts",
    "crawl": "tsx --env-file=.env.local scripts/crawl/main.ts",
    "crawl:cron": "tsx scripts/crawl/cron.ts",
    "commentary:todo": "tsx --env-file=.env.local scripts/commentary/todo.ts",
    "commentary:draft": "tsx --env-file=.env.local scripts/commentary/draft-batch.ts",
    "commentary:publish": "tsx --env-file=.env.local scripts/commentary/publish.ts",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@sentry/nextjs": "^11.12.0",
    "@sentry/node": "^11.12.0",
    "bezier-easing": "^3.2.0",
    "next": "16.4.6",
    "posthog-js": "^1.449.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "undici": "^8.12.4",
    "vite": "^8.3.8",
    "vite-plus": "^1.8.0",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@10.34.9"
}
