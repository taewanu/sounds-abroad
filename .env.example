# Copy to .env.local and fill in. Names only: never commit values.
# `pnpm crawl` and the `commentary:*` scripts load .env.local via tsx --env-file.
# Deployed values live in Vercel (app) and GitHub Actions secrets (crawl, CI).

# --- App runtime (Next.js server and client) ---

# Required by the app: published charts.json URL; read by the /api/charts, /api/songs and /api/playlist routes and /debug/charts. commentary:todo and commentary:draft also require it. The crawl reads it to carry the previous charts forward and skips that with a warning when unset.
CHARTS_BLOB_URL=
# Optional: key sent with chart-store reads; unset sends no key (needed only once the store refuses unauthenticated reads).
CHARTS_READ_KEY=
# Required in production: bearer token /api/revalidate checks; the cron crawl sends the same value. Unset makes the route return 500 and makes the cron crawl fail after it has published.
REVALIDATE_SECRET=
# Optional: Sentry DSN for browser, server, edge and the crawl's error reports; unset disables reporting (the cron crawl throws without it).
NEXT_PUBLIC_SENTRY_DSN=
# Optional: PostHog project key; unset turns analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional: PostHog ingest origin; defaults to https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=
# Optional: set to 1 to enable the /debug/charts page (evaluated at build time).
ENABLE_DEBUG=

# --- Build (Sentry source-map upload, read by next.config.ts) ---

# Optional: Sentry organization slug for source-map upload.
SENTRY_ORG=
# Optional: Sentry project slug for source-map upload.
SENTRY_PROJECT=
# Optional: Sentry auth token for source-map upload. No code here reads it: the Sentry build plugin does. The Sentry wizard writes it to .env.sentry-build-plugin, which is ignored.
SENTRY_AUTH_TOKEN=

# --- Crawl and commentary scripts (pnpm crawl, crawl:cron, commentary:*) ---

# The four R2 values are required by crawl, crawl:cron, commentary:draft and commentary:publish; commentary:todo runs without them.
# Required: Cloudflare account ID of the R2 bucket the crawl publishes to.
R2_ACCOUNT_ID=
# Required: R2 access key ID for writing the bucket.
R2_ACCESS_KEY_ID=
# Required: R2 secret access key for writing the bucket.
R2_SECRET_ACCESS_KEY=
# Required: public base URL the bucket's objects are served from.
R2_PUBLIC_BASE_URL=
# Optional: commentary store URL baked into the charts; unset skips commentary with a warning.
COMMENTARY_BLOB_URL=
# Optional: Spotify app client ID; both Spotify values are needed for exact track links, else links fall back to search URLs.
SPOTIFY_CLIENT_ID=
# Optional: Spotify app client secret; pair with SPOTIFY_CLIENT_ID.
SPOTIFY_CLIENT_SECRET=
# Optional: URL of an earlier charts.json that commentary:todo and commentary:draft compare against.
CHARTS_PREV_BLOB_URL=

# --- Set by workflows or tests, not .env.local ---

# Crawl workflow: origin the crawl asks to revalidate; cron-crawl.yml sets it as a plain value. Tests set it too.
# SITE_URL=

# --- Injected by the platform or CI, never set by hand ---
# CI                              GitHub Actions; makes the Sentry build plugin log.
# NODE_ENV                        Next.js and tooling.
# NEXT_RUNTIME                    Next.js; picks the Sentry server or edge config.
# VERCEL_ENV                      Vercel; Sentry environment tag.
# VERCEL_GIT_COMMIT_SHA           Vercel; Sentry release and /api/health.
# VERCEL_GIT_COMMIT_REF           Vercel; Sentry branch tag.
# VERCEL_REGION                   Vercel; Sentry region tag.
# NEXT_PUBLIC_VERCEL_ENV          Vercel, exposed to the browser; Sentry and PostHog environment tag.
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA  Vercel, exposed to the browser; Sentry release.
# GITHUB_RUN_ID                   GitHub Actions; tags crawl error reports.
# GITHUB_SHA                      GitHub Actions; crawl Sentry release.
